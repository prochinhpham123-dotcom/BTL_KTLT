		return authorId; 
    }

    bool isBookInActiveBorrowSlip(string bookId) {
        ifstream file("data/borrow_slips.txt");
        if (!file.is_open()) return false; 
        string line;
        while (getline(file, line)) {
            if (line.find(bookId) != string::npos && line.find("CHUA_TRA") != string::npos) {
                file.close();
                return true;
            }
        }
        file.close();
        return false;
    }

