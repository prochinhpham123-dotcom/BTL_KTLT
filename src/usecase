        loadFromFile();
    }

    void loadFromFile() {
        books.clear();
        ifstream file(filePath);
        if (!file.is_open()) return;
        string line;
        while (getline(file, line)) {
            if (!line.empty()) {
                books.push_back(Book::fromString(line));
            }
        }
        file.close();
    }

    void saveToFile() {
        system("mkdir data 2>nul");
        ofstream file(filePath);
        for (const auto& book : books) {
            file << book.toString() << endl;
