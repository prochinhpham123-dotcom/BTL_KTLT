using namespace std;

class Book {
private:
    string id;
    string title;
    string authorId;
    int publishYear;
    double price;
    int quantity;

public:
    Book() {}
    Book(string id, string title, string authorId, int publishYear, double price, int quantity) {
        this->id = id;
        this->title = title;
        this->authorId = authorId;
        this->publishYear = publishYear;
        this->price = price;
        this->quantity = quantity;
    }

    string getId() const { return id; }
    void setId(string id) { this->id = id; }

    string getTitle() const { return title; }
    void setTitle(string title) { this->title = title; }

    string getAuthorId() const { return authorId; }
    void setAuthorId(string authorId) { this->authorId = authorId; }

    int getPublishYear() const { return publishYear; }
    void setPublishYear(int publishYear) { this->publishYear = publishYear; }

    double getPrice() const { return price; }
    void setPrice(double price) { this->price = price; }

    int getQuantity() const { return quantity; }
    void setQuantity(int quantity) { this->quantity = quantity; }

    string toString() const {
        return id + "|" + title + "|" + authorId + "|" + to_string(publishYear) + "|" + to_string(price) + "|" + to_string(quantity);
    }

    static Book fromString(string line) {
        size_t pos = 0;
        vector<string> tokens;
        while ((pos = line.find("|")) != string::npos) {
            tokens.push_back(line.substr(0, pos));
            line.erase(0, pos + 1);
        }
        tokens.push_back(line); 
        if (tokens.size() >= 6) {
            return Book(tokens[0], tokens[1], tokens[2], stoi(tokens[3]), stod(tokens[4]), stoi(tokens[5]));
        }
        return Book();
    }

    void displayRow() const {
        cout << left << setw(10) << id 
             << setw(25) << title.substr(0, 23) 
             << setw(12) << authorId 
             << setw(10) << publishYear 
             << setw(12) << fixed << setprecision(0) << price 
             << setw(10) << quantity << endl;
    }
};

class BookManager {
private:
    vector<Book> books;
